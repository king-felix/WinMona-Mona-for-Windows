{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mona/build/requirements-windows.schema.json",
  "title": "Mona Windows improvement supplement ledger (docs/requirements-windows.json)",
  "description": "Pending registry for the W00-W25 prompts and WX requirement rows. Deliberately separate from docs/requirements.json so the original P00-P23 id space keeps its own validated namespace.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "spec", "purpose", "prompts", "requirements"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "companion_file", "version", "sha256", "companion_sha256"],
      "properties": {
        "file": { "const": "Mona_Windows_Improvements_Project.md" },
        "companion_file": { "const": "Mona_Windows_Improvements_PROMPTS.md" },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "companion_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "indexed_utc": { "type": "string" }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "deliverable",
          "prerequisites",
          "spec_sections",
          "acceptance",
          "checkpoint",
          "requirements",
          "status",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^W[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "deliverable": { "type": "string", "minLength": 1 },
          "prerequisites": {
            "type": "array",
            "items": { "type": "string", "pattern": "^W[0-9]{2}$" },
            "uniqueItems": true
          },
          "spec_sections": {
            "type": "array",
            "items": { "type": "string", "pattern": "^S[0-9]{2}$" },
            "uniqueItems": true
          },
          "acceptance": { "type": "string", "minLength": 1 },
          "checkpoint": { "type": ["string", "null"], "minLength": 1 },
          "requirements": {
            "type": "array",
            "items": { "type": "string", "pattern": "^WX-[0-9]{2}$" },
            "uniqueItems": true
          },
          "status": {
            "enum": ["pending", "running", "verifying", "completed", "blocked", "interrupted", "skipped"]
          },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/definitions/evidenceRef" }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "owning_prompts",
          "status",
          "criteria",
          "verified_commit",
          "tested_environment",
          "open_issue_ids",
          "original_requirements"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^WX-[0-9]{2}$" },
          "title": { "type": "string", "minLength": 1 },
          "owning_prompts": {
            "type": "array",
            "items": { "type": "string", "pattern": "^W[0-9]{2}$" },
            "uniqueItems": true
          },
          "status": {
            "enum": ["pending", "partial", "verified", "blocked", "skipped"]
          },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "status", "evidence"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
                "description": { "type": "string" },
                "status": {
                  "enum": ["pending", "partial", "passed", "failed", "blocked", "not_applicable"]
                },
                "evidence": {
                  "type": "array",
                  "items": { "$ref": "#/definitions/evidenceRef" }
                }
              }
            }
          },
          "verified_commit": { "type": ["string", "null"] },
          "tested_environment": { "type": ["string", "null"] },
          "open_issue_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^ISSUE-[0-9]{4}$" },
            "uniqueItems": true
          },
          "original_requirements": {
            "type": "array",
            "items": { "type": "string", "pattern": "^MONA-[0-9]{3}$" },
            "uniqueItems": true,
            "description": "Original-ledger requirements this supplement outcome affects. S10 requires the implementer to record this mapping; validation refuses a verified row without it."
          }
        }
      }
    }
  },
  "definitions": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "note": { "type": "string" },
        "kind": { "enum": ["real", "fixture", "human", "generated", "document"] },
        "recorded_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
        "commit": { "type": ["string", "null"] }
      }
    }
  }
}

