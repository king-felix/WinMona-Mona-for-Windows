{
  "name": "mona",
  "version": "0.0.0",
  "private": true,
  "description": "Mona — a local desktop workbench for Codewhale. Desktop app and shared contracts live in apps/desktop and packages/*; the bootstrap utility stays in tools/build.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mona": "node tools/build/cli.mjs",
    "index": "node tools/build/cli.mjs index",
    "validate": "node tools/build/cli.mjs validate",
    "bootstrap:test": "node --test tests/bootstrap",
    "launch:test": "node --test tests/launch",
    "spike:test": "node --test tests/spike",
    "install:test": "node --test tests/install",
    "native:build": "node native/windows-shell/build.mjs",
    "native:test": "node --test tests/native",
    "tools:fetch": "node tools/install/fetch-tools.mjs",
    "test": "vitest run && npm run assets:test && npm run bootstrap:test && npm run launch:test && npm run install:test && npm run spike:test",
    "build": "npm run build -w @mona/contracts && npm run build -w @mona/adapter && npm run build -w @mona/project-state && npm run build -w @mona/ui && npm run build -w @mona/desktop",
    "typecheck": "npm run build -w @mona/contracts && npm run typecheck -w @mona/adapter && npm run typecheck -w @mona/project-state && npm run typecheck -w @mona/ui && npm run typecheck -w @mona/desktop",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run assets:check && npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "smoke": "npm run smoke -w @mona/desktop",
    "launch": "npm run launch -w @mona/desktop",
    "polish": "npm run polish -w @mona/desktop",
    "terminal": "npm run terminal -w @mona/desktop",
    "launch:menu": "node tools/launch/context-menu.mjs",
    "mona:stage": "node tools/install/cli.mjs stage",
    "mona:install": "node tools/install/cli.mjs install",
    "mona:uninstall": "node tools/install/cli.mjs uninstall",
    "mona:status": "node tools/install/cli.mjs status",
    "qa": "npm run qa -w @mona/desktop",
    "appearance": "npm run appearance -w @mona/desktop",
    "composer": "npm run composer -w @mona/desktop",
    "slash": "npm run slash -w @mona/desktop",
    "focus": "npm run focus -w @mona/desktop",
    "surfaces": "npm run surfaces -w @mona/desktop",
    "assets:icons": "node tools/assets/build-icons.mjs",
    "assets:check": "node tools/assets/build-icons.mjs --check",
    "assets:test": "node --test tests/assets"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "node-pty": false
  }
}
