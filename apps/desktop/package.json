{
  "name": "@mona/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run clean && npm run build:main && node scripts/copy-capabilities.mjs && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "lifecycle": "node scripts/lifecycle.mjs",
    "shots": "node scripts/shots.mjs",
    "catalog": "node scripts/catalog.mjs",
    "studio": "node scripts/studio.mjs",
    "launch": "node scripts/launch.mjs",
    "polish": "node scripts/polish.mjs",
    "terminal": "node scripts/terminal.mjs",
    "check:build": "node scripts/check-build.mjs",
    "verify": "npm run build && npm run check:build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@mona/adapter": "0.1.0",
    "@mona/contracts": "0.1.0",
    "@mona/project-state": "0.1.0",
    "@mona/ui": "0.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.0",
    "esbuild": "0.28.2",
    "vite": "8.3.8"
  }
}
